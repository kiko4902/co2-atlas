{
  "name": "co2-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive atlas of fossil CO2 emissions by country, 1950-2024 (Global Carbon Project data, D3 + Vite).",
  "license": "MIT",
  "author": "Kristian Džoić",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-axis": "3.0.0",
    "d3-ease": "3.0.1",
    "d3-format": "3.1.2",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/d3-array": "3.2.2",
    "@types/d3-axis": "3.0.6",
    "@types/d3-ease": "3.0.2",
    "@types/d3-format": "3.0.4",
    "@types/d3-geo": "3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "3.1.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "gifenc": "1.0.3",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
